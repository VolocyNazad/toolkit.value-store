<Project Sdk="Microsoft.NET.Sdk">

	<PropertyGroup>
		<TargetFrameworks>net48;net8.0-windows</TargetFrameworks>
		<GeneratePackageOnBuild>true</GeneratePackageOnBuild>
	</PropertyGroup>

	<PropertyGroup>
		<Authors>VolocyNazad</Authors>
		<NeutralLanguage>en-US</NeutralLanguage>
		<Copyright>Copyright © VolocyNazad</Copyright>
		<Description>File-backed, DI-friendly value store with YAML serialization and change notifications.</Description>
		<PackageType>Dependency</PackageType>
		<PackageTags>settings;configuration;yaml;value-store;dotnet;</PackageTags>
		<PackageId>VolocyNazad.ValueStore</PackageId>
		<PackageReadmeFile>README.md</PackageReadmeFile>
		<PackageProjectUrl>https://github.com/VolocyNazad/toolkit.value-store</PackageProjectUrl>
		<PackageOutputPath>..\..\artifacts\</PackageOutputPath>
		<RepositoryType>git</RepositoryType>
		<RepositoryUrl>https://github.com/VolocyNazad/toolkit.value-store</RepositoryUrl>
		<PackageReleaseNotes>https://github.com/VolocyNazad/toolkit.value-store/blob/main/CHANGELOG.md</PackageReleaseNotes>
		<PackageLicenseFile>LICENSE.md</PackageLicenseFile>
	</PropertyGroup>

	<ItemGroup>
		<None Include="..\..\README.md" Pack="true" PackagePath="" Visible="false" />
		<None Include="..\..\LICENSE.md" Pack="true" PackagePath="" Visible="false" />
	</ItemGroup>

	<!--
		MinVer computes the package version from git tags/commit history (regular semver, not tied to a Revit version).
		If HEAD doesn't match a tag, MinVer increments patch itself and adds the suffix "dev.<number of commits after the tag>",
		e.g.: tag "1.0.0" + 4 commits after it -> "1.0.1-dev.4".
	-->
	<PropertyGroup>
		<MinVerTagPrefix></MinVerTagPrefix>
		<MinVerDefaultPreReleaseIdentifiers>dev</MinVerDefaultPreReleaseIdentifiers>
	</PropertyGroup>

	<ItemGroup>
		<PackageReference Include="Microsoft.Extensions.DependencyInjection" />
		<PackageReference Include="Microsoft.Extensions.Logging.Abstractions" />
		<PackageReference Include="Microsoft.Extensions.Options" />
		<PackageReference Include="YamlDotNet" />
		<PackageReference Include="PolySharp">
			<PrivateAssets>all</PrivateAssets>
			<IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
		</PackageReference>
	</ItemGroup>

	<ItemGroup>
		<InternalsVisibleTo Include="Toolkit.ValueStore.Tests" />
	</ItemGroup>

</Project>
