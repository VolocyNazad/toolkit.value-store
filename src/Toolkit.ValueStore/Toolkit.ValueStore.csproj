<Project Sdk="Microsoft.NET.Sdk">

	<PropertyGroup>
		<TargetFrameworks>net48;net8.0-windows</TargetFrameworks>
		<GeneratePackageOnBuild>true</GeneratePackageOnBuild>
	</PropertyGroup>

	<PropertyGroup>
		<Authors>VolocyNazad</Authors>
		<NeutralLanguage>en-US</NeutralLanguage>
		<Copyright>Copyright © VolocyNazad</Copyright>
		<Description>File-backed, DI-friendly value store with YAML serialization and change notifications.</Description>
		<PackageType>Dependency</PackageType>
		<PackageTags>settings;configuration;yaml;value-store;dotnet;</PackageTags>
		<PackageId>VolocyNazad.ValueStore</PackageId>
		<PackageReadmeFile>README.md</PackageReadmeFile>
		<PackageProjectUrl>https://github.com/VolocyNazad/toolkit.value-store</PackageProjectUrl>
		<PackageOutputPath>..\..\artifacts\</PackageOutputPath>
		<RepositoryType>git</RepositoryType>
		<RepositoryUrl>https://github.com/VolocyNazad/toolkit.value-store</RepositoryUrl>
		<PackageReleaseNotes>https://github.com/VolocyNazad/toolkit.value-store/blob/main/CHANGELOG.md</PackageReleaseNotes>
		<PackageLicenseFile>LICENSE.md</PackageLicenseFile>
	</PropertyGroup>

	<ItemGroup>
		<None Include="..\..\README.md" Pack="true" PackagePath="" Visible="false" />
		<None Include="..\..\LICENSE.md" Pack="true" PackagePath="" Visible="false" />
	</ItemGroup>

	<!--
		MinVer вычисляет версию пакета по git-тегам/истории коммитов (обычная semver, без привязки к версии Revit).
		Если HEAD не совпадает с тегом, MinVer сам увеличивает patch и добавляет суффикс "dev.<кол-во коммитов после тега>",
		например: тег "1.0.0" + 4 коммита после него -> "1.0.1-dev.4".
	-->
	<PropertyGroup>
		<MinVerTagPrefix></MinVerTagPrefix>
		<MinVerDefaultPreReleaseIdentifiers>dev</MinVerDefaultPreReleaseIdentifiers>
	</PropertyGroup>

	<ItemGroup>
		<PackageReference Include="Microsoft.Extensions.DependencyInjection" Version="10.0.9" />
		<PackageReference Include="Microsoft.Extensions.Logging.Abstractions" Version="10.0.9" />
		<PackageReference Include="Microsoft.Extensions.Options" Version="10.0.9" />
		<PackageReference Include="YamlDotNet" Version="18.1.0" />
		<PackageReference Include="PolySharp" Version="1.16.0">
			<PrivateAssets>all</PrivateAssets>
			<IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
		</PackageReference>
		<PackageReference Include="MinVer" Version="6.*">
			<PrivateAssets>all</PrivateAssets>
			<IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
		</PackageReference>
	</ItemGroup>

	<ItemGroup>
		<InternalsVisibleTo Include="Toolkit.ValueStore.Tests" />
	</ItemGroup>

</Project>
